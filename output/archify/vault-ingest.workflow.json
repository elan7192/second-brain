{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "Vault ingest workflow",
    "output": "output/archify/vault-ingest.html",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "drop-to-pages",
        "label": "Drop to pages",
        "focus": ["lan_e", "raw", "read", "source_page"],
        "note": "lan E drops a source. The agent reads it as untrusted data and writes a source page."
      },
      {
        "id": "compile",
        "label": "Compile claims",
        "focus": ["source_page", "claims_csv", "validate"],
        "note": "Claims kept compile to CSV. Concept pages go to validate."
      },
      {
        "id": "gates",
        "label": "Accept or stop",
        "focus": ["validate", "ingest_check", "stop"],
        "note": "sb validate then ingest-check accept the patch. Missing links stop the write."
      }
    ]
  },
  "lanes": [
    { "id": "human", "label": "Human-owned" },
    { "id": "compiler", "label": "Agent compiler" },
    { "id": "catalogs", "label": "Claim tables" },
    { "id": "gates", "label": "sb gates" },
    { "id": "exceptions", "label": "Stop conditions", "variant": "exception" }
  ],
  "phases": [
    { "id": "drop", "label": "Drop", "fromCol": 0, "toCol": 1 },
    { "id": "compile", "label": "Compile", "fromCol": 2, "toCol": 3, "variant": "emphasis" },
    { "id": "accept", "label": "Accept", "fromCol": 4, "toCol": 5, "variant": "dashed" }
  ],
  "mainPath": ["lan_e", "raw", "read", "source_page", "validate", "ingest_check"],
  "nodes": [
    { "id": "lan_e", "lane": "human", "col": 0, "type": "external", "label": "lan E", "sublabel": "named owner" },
    { "id": "raw", "lane": "human", "col": 1, "type": "database", "label": "raw/", "sublabel": "immutable", "tag": "no agent writes" },
    { "id": "read", "lane": "compiler", "col": 2, "type": "backend", "label": "Read source", "sublabel": "untrusted data" },
    { "id": "source_page", "lane": "compiler", "col": 3, "type": "backend", "label": "Source page", "sublabel": "Claims kept" },
    { "id": "claims_csv", "lane": "catalogs", "col": 2, "type": "database", "label": "claims.csv", "sublabel": "compile-claims" },
    { "id": "validate", "lane": "gates", "col": 4, "type": "security", "label": "sb validate", "sublabel": "lint-wiki", "tag": "code accepts" },
    { "id": "ingest_check", "lane": "gates", "col": 5, "type": "security", "label": "ingest-check", "sublabel": "named slug" },
    { "id": "stop", "lane": "exceptions", "col": 4, "type": "security", "label": "Stop", "sublabel": "fix missing links" }
  ],
  "edges": [
    { "from": "lan_e", "to": "raw", "variant": "emphasis" },
    { "from": "raw", "to": "read", "variant": "emphasis", "route": "drop", "fromSide": "bottom", "toSide": "top" },
    { "from": "read", "to": "source_page" },
    { "from": "source_page", "to": "validate", "variant": "security", "route": "drop", "fromSide": "bottom", "toSide": "top" },
    { "from": "source_page", "to": "claims_csv", "label": "compile", "route": "drop", "fromSide": "bottom", "toSide": "top" },
    { "from": "validate", "to": "ingest_check", "variant": "emphasis" },
    { "from": "validate", "to": "stop", "variant": "security", "role": "error", "route": "drop", "fromSide": "bottom", "toSide": "top" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Ingest",
      "items": [
        "raw/ stays immutable. Wiki is compiled.",
        "One source updates only the pages it changes."
      ]
    },
    {
      "dot": "violet",
      "title": "C17",
      "items": [
        "CSV compile is shown. YAML is the other table.",
        "Do not pick a canonical table."
      ]
    },
    {
      "dot": "rose",
      "title": "Gates",
      "items": [
        "validate then ingest-check must exit 0.",
        "Orphans and missing ids stop the write."
      ]
    }
  ]
}
